# Copy this file to .env and point it at your backend.
# Postman docs show endpoints mounted at /api/v1/ under a {{Base_url}} variable —
# put that same base URL here, including the /api/v1 segment.
VITE_API_BASE_URL=https://your-backend-host/api/v1

# Paystack PUBLISHABLE key (safe to expose client-side — starts with pk_test_
# or pk_live_). Never put a secret key (sk_...) in a frontend .env file.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
